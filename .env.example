# Copy to .env and fill in real values. .env is gitignored; this file must
# never contain a working credential.

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=polaris
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_me
DATABASE_URL=postgresql+psycopg://postgres:replace_me@localhost:5432/polaris
# Required only for pytest; use a disposable local database ending in _test or _scratch.
POLARIS_TEST_DATABASE_URL=postgresql+psycopg://postgres:replace_me@localhost:5432/polaris_test

# --- Discovery ---
# Which search backend the discovery surface uses: ddgs (default), serper,
# or null (no internet; tests/dry runs). Any other value fails fast at
# startup instead of silently falling back.
POLARIS_SEARCH_PROVIDER=ddgs

# serper: Google search via Serper.dev. Only needed when explicitly selected;
# the rest of the pipeline runs without it. Never required for ddgs or null.
POLARIS_SERPER_API_KEY=

# ddgs: free DuckDuckGo metasearch via the `ddgs` library — no API key.
# It is a best-effort upstream service: results can be throttled or blocked
# at any time, and discovery degrades (reported in run metrics) when that
# happens. Optional proxy, e.g. socks5://127.0.0.1:1080:
# DDGS_PROXY=

# --- Deployment ---
# Comma-separated origins allowed to call the API cross-origin.
# Leave empty for a single-origin deployment (the API serves frontend/dist).
# Set it ONLY when the frontend is hosted separately — the public read and
# matching API has no authentication, so a wildcard origin would expose it to
# the whole internet. CORS is not an authentication mechanism.
POLARIS_ALLOWED_ORIGINS=

# --- LLM enrichment (optional) ---
# Gemini via Google AI Studio. The free tier is enough: enrichment is a
# batch job (scripts/enrich_records.py --llm), throttled client-side to
# ~15 RPM with a per-run call budget. Without a key the LLM pass is off
# and the deterministic pipeline runs complete without it.
GEMINI_API_KEY=<redacted>
# POLARIS_LLM_MODEL=gemini-2.5-flash
# POLARIS_LLM_MIN_INTERVAL_SECONDS=4

# --- Admin review ---
# Bearer token required by /api/v1/admin/review/*. When unset the surface is
# disabled (503) rather than open. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
POLARIS_ADMIN_TOKEN=replace_with_a_long_random_value
